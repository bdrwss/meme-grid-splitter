/* 顶部搜索区固定：列表滚动时保持可见 */
.search-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f8fafc;
  padding: 8rpx 0 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.search-icon {
  color: #94a3b8;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-ph {
  color: #94a3b8;
}

.search-clear {
  color: #cbd5e1;
  padding: 0 8rpx;
}

.binding-bar {
  display: flex;
  align-items: center;
  background: #fef3c7;
  border: 1rpx solid #fde68a;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}

.binding-bar.ok {
  background: #dcfce7;
  border-color: #bbf7d0;
}

.binding-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d97706;
  margin-right: 16rpx;
}

.binding-bar.ok .binding-dot {
  background: #16a34a;
}

.binding-text {
  flex: 1;
  font-size: 26rpx;
  color: #78350f;
}

.binding-bar.ok .binding-text {
  color: #14532d;
}

.binding-arrow {
  color: #a16207;
  font-size: 30rpx;
}

.tool-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tool-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.tool-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #3b82f6, #6366f1);
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.tool-info {
  flex: 1;
  min-width: 0;
}

.tool-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
}

.tool-sub {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-tag {
  font-size: 20rpx;
  color: #d97706;
  background: #fef3c7;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tool-arrow {
  color: #cbd5e1;
  font-size: 36rpx;
  margin-left: 8rpx;
}

.empty {
  background: #fff;
  border-radius: 20rpx;
  padding: 80rpx 0;
  text-align: center;
  color: #64748b;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.footer-hint {
  text-align: center;
  color: #94a3b8;
  font-size: 22rpx;
  padding: 40rpx 0 16rpx;
}

/* 云端模式：封禁用户全屏拦截（PRD 三.1 情况A） */
.blocked-full {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.blocked-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.blocked-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.blocked-text {
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.6;
}
