<view class="page">
  <!-- 云端模式：封禁全屏拦截（PRD 三.1 情况A） -->
  <view wx:if="{{isBanned}}" class="blocked">
    <view class="blocked-icon">⛔</view>
    <view class="blocked-title">无法使用</view>
    <view class="blocked-text">您的账号已被管理员停用，无法使用本工具</view>
  </view>

  <block wx:if="{{!isBanned}}">
    <!-- 账户头部：
         - 未绑定时：点击头像区域唤起身份选择模态弹窗；
         - 已绑定时：点击头像区域或设置按钮弹出个人信息编辑弹窗；
         - 品牌文字区域连点 5 次触发管理员彩蛋。
    -->
    <view class="hero">
      <view class="hero-avatar-wrap" catchtap="onAvatarClick">
        <image class="hero-logo" src="{{userAvatar || '/avatar.png'}}" mode="aspectFill"></image>
        <!-- 仅在未绑定时显示“点此绑定”，成功绑定后立即消失 -->
        <view class="hero-avatar-hint" wx:if="{{!isBound}}">点此绑定</view>
      </view>

      <view class="hero-main" bindtap="onBrandTap">
        <view class="hero-name">{{displayName}}</view>
        <view class="hero-sub">{{displaySub}}</view>
      </view>

      <!-- 右侧状态标签：
           - 未绑定时：显示“未激活”标签，点击弹出身份绑定弹窗；
           - 已绑定时：绝不显示“未激活”，替换为当前真实身份徽标与设置入口。
      -->
      <view
        wx:if="{{!isBound}}"
        class="hero-badge"
        catchtap="onAvatarClick"
      >
        未激活
      </view>
    </view>

    <!-- 云端：加载中 -->
    <view class="card" wx:if="{{cloudMode && loading}}">
      <view class="muted">正在静默登录…</view>
    </view>

    <!-- 云端：学员视图（PRD 四.1，仅在已绑定为学员时显示） -->
    <view class="card account-card {{accountCardExpanded ? 'expanded' : 'collapsed'}}" wx:if="{{cloudMode && !loading && session && session.state === 'student'}}">
      <view class="card-header-row clickable" bindtap="toggleAccountCard">
        <view class="card-title-group">
          <view class="section-title">学员信息</view>
          <view class="account-summary-pill ok" wx:if="{{!accountCardExpanded}}">
            已认证
          </view>
        </view>
        <view class="expand-toggle-btn">
          <text class="expand-text">{{accountCardExpanded ? '收起' : '展开'}}</text>
          <text class="expand-arrow {{accountCardExpanded ? 'expanded' : ''}}">▾</text>
        </view>
      </view>

      <view class="expand-body" wx:if="{{accountCardExpanded}}">
        <view class="kv"><text class="k">学员姓名</text><text class="v">{{session.name || '未设置'}}</text></view>
        <view class="kv"><text class="k">所属班级</text><text class="v">{{session.className || session.batchNo || '未设置'}}</text></view>
        <view class="kv"><text class="k">学员年龄</text><text class="v">{{session.age ? session.age + ' 岁' : '未设置'}}</text></view>
        <view class="kv"><text class="k">喜播 UID</text><text class="v mono">{{session.uid}}</text></view>
        <view class="kv"><text class="k">归属教师</text><text class="v">{{session.teacherUid || '公共学员'}}</text></view>
        <view class="notice">登录态基于微信静默鉴权，更换手机后登录同一微信即可自动恢复。</view>
        <view class="btn-primary btn-block" style="margin-top: 24rpx;" bindtap="openProfileModal">编辑个人资料</view>
      </view>
    </view>

    <!-- 云端：教师视图（PRD 四.2，仅在已绑定为教师/管理员时显示） -->
    <view class="card" wx:if="{{cloudMode && !loading && session && (session.state === 'teacher' || session.state === 'admin')}}">
      <view class="card-header-row">
        <view class="section-title">教师工作台</view>
        <view class="text-link-btn" bindtap="openProfileModal">资料设置 ›</view>
      </view>
      <view class="kv" wx:if="{{session.name}}"><text class="k">教师姓名</text><text class="v">{{session.name}}</text></view>
      <view class="kv"><text class="k">教师 UID</text><text class="v mono">{{session.uid}}</text></view>
      <view class="row-note" style="margin-top: 8rpx;">分批次录入学员 UID、筛选查询、解绑换绑与移除</view>
      <view class="btn-primary btn-block" bindtap="goPool">我的学员库</view>
    </view>

    <!-- 云端：管理员快捷入口（彩蛋验证通过后的常驻入口） -->
    <view class="card" wx:if="{{cloudMode && !loading && session && session.state === 'admin'}}">
      <view class="section-title">管理员</view>
      <view class="row-note">授权码生成 / 教师管控 / 一级总学员库</view>
      <view class="btn-primary btn-block" bindtap="goAdmin">进入超级管理员后台</view>
    </view>

    <!-- 旧模式（未启用云开发）：仅在已激活时展示本机绑定状态卡片，未激活不直接显示输入框 -->
    <block wx:if="{{!cloudMode}}">
      <view class="card account-card {{accountCardExpanded ? 'expanded' : 'collapsed'}}" wx:if="{{binding}}">
        <view class="card-header-row clickable" bindtap="toggleAccountCard">
          <view class="card-title-group">
            <view class="section-title">账户与激活</view>
            <view class="account-summary-pill {{binding.active ? 'ok' : 'bad'}}" wx:if="{{!accountCardExpanded}}">
              {{binding.active ? '生效中' : '已过期'}}
            </view>
          </view>
          <view class="expand-toggle-btn">
            <text class="expand-text">{{accountCardExpanded ? '收起' : '展开'}}</text>
            <text class="expand-arrow {{accountCardExpanded ? 'expanded' : ''}}">▾</text>
          </view>
        </view>

        <view class="expand-body" wx:if="{{accountCardExpanded}}">
          <view class="kv" wx:if="{{binding.name}}"><text class="k">学员姓名</text><text class="v">{{binding.name}}</text></view>
          <view class="kv" wx:if="{{binding.className}}"><text class="k">所属班级</text><text class="v">{{binding.className}}</text></view>
          <view class="kv" wx:if="{{binding.age}}"><text class="k">学员年龄</text><text class="v">{{binding.age}} 岁</text></view>
          <view class="kv">
            <text class="k">UID</text>
            <text class="v mono">{{binding.uid}}</text>
          </view>
          <view class="kv">
            <text class="k">激活状态</text>
            <text class="v {{binding.active ? 'ok' : 'bad'}}">{{binding.active ? '生效中' : '已过期'}}</text>
          </view>
          <view class="kv">
            <text class="k">有效期至</text>
            <text class="v">{{binding.expiresText}}</text>
          </view>
          <view class="kv" wx:if="{{binding.active}}">
            <text class="k">剩余天数</text>
            <text class="v">{{binding.daysLeft}} 天</text>
          </view>
          <view class="notice {{binding.active ? '' : 'warn'}}">
            {{binding.active ? '已绑定本机 UID，点击头像或编辑按钮可修改个人资料。' : '激活已过期，请重新激活。'}}
          </view>
          <view class="btn-primary btn-block" style="margin-top: 24rpx;" bindtap="openProfileModal">编辑个人资料</view>
          <view class="btn-ghost btn-block" style="margin-top: 16rpx;" bindtap="onUnbindLegacy">解除绑定</view>
        </view>
      </view>

      <!-- 教师模式（旧模式：已解锁时显示） -->
      <view class="card" wx:if="{{teacherUnlocked}}">
        <view class="section-title">教师模式</view>
        <view class="row-note">本机已解锁，可生成学员激活码</view>
        <view class="btn-primary btn-block" bindtap="goTeacher">进入教师工具</view>
        <view class="btn-ghost btn-block gap" bindtap="onLockTeacher">锁定教师模式</view>
      </view>
    </block>

    <!-- 关于 -->
    <view class="card">
      <view class="section-title">关于</view>
      <view class="about-text">
        本工具全部视频处理均在本机完成，不联网、不上传任何视频，卸载小程序后本机数据一并清除。
        输出为 GIF 动图，可按格逐张或一次性保存到相册。
      </view>
      <view class="kv">
        <text class="k">版本</text>
        <text class="v">{{version}}</text>
      </view>
    </view>

    <view class="footer-hint">{{isBound ? '点击头像或上方设置即可更新个人信息' : '点击上方头像即可进行身份绑定与激活'}}</view>

    <!-- 弹窗 1：身份选择与绑定弹窗（未绑定时点击头像唤出） -->
    <view class="modal-mask" wx:if="{{roleModalVisible}}" catchtap="onCloseRoleModal">
      <view class="modal role-modal" catchtap="noop">
        <!-- 步骤 1：身份选择 -->
        <block wx:if="{{roleModalStep === 'choose'}}">
          <view class="modal-header">
            <view class="modal-title">选择您的身份</view>
            <view class="modal-close" catchtap="onCloseRoleModal">✕</view>
          </view>
          <view class="modal-desc">请确认您要绑定的身份类型</view>

          <view class="role-cards">
            <view class="role-card" hover-class="role-card-hover" catchtap="onSelectRole" data-role="student">
              <view class="role-icon">🎓</view>
              <view class="role-meta">
                <view class="role-meta-title">我是学员</view>
                <view class="role-meta-sub">仅需输入喜播 UID 即可直接绑定</view>
              </view>
              <view class="role-meta-arrow">›</view>
            </view>

            <view class="role-card" hover-class="role-card-hover" catchtap="onSelectRole" data-role="teacher">
              <view class="role-icon">👨‍🏫</view>
              <view class="role-meta">
                <view class="role-meta-title">我是教师</view>
                <view class="role-meta-sub">凭教师 UID 与激活码注册管理</view>
              </view>
              <view class="role-meta-arrow">›</view>
            </view>
          </view>

          <view class="modal-footer-cancel" catchtap="onCloseRoleModal">取消</view>
        </block>

        <!-- 步骤 2：差异化表单（学员 / 教师） -->
        <block wx:if="{{roleModalStep !== 'choose'}}">
          <view class="modal-header">
            <view class="modal-back" catchtap="onBackToRoleChoose">‹ 返回</view>
            <view class="modal-title">{{roleModalStep === 'student' ? '学员绑定' : '教师注册与激活'}}</view>
            <view class="modal-close" catchtap="onCloseRoleModal">✕</view>
          </view>

          <!-- 身份切换标签 -->
          <view class="role-tabs">
            <view class="role-tab {{roleModalStep === 'student' ? 'active' : ''}}" catchtap="onSelectRole" data-role="student">学员绑定</view>
            <view class="role-tab {{roleModalStep === 'teacher' ? 'active' : ''}}" catchtap="onSelectRole" data-role="teacher">教师激活</view>
          </view>

          <!-- 差异化表单区域 -->
          <view class="role-form">
            <!-- 学员表单：仅显示 UID 输入框 -->
            <block wx:if="{{roleModalStep === 'student'}}">
              <view class="field-item">
                <view class="field-title">喜播 UID</view>
                <input
                  class="field-input"
                  placeholder="请输入喜播教育 UID，如 XB10086"
                  value="{{bindUid}}"
                  bindinput="onBindUidInput"
                  focus="{{roleModalStep === 'student'}}"
                />
                <view class="field-tip">请输入带班老师录入在学员总表的喜播 UID，系统将静默核验并绑定微信。</view>
              </view>
            </block>

            <!-- 教师表单：同时显示 UID 和 激活码输入框 -->
            <block wx:if="{{roleModalStep === 'teacher'}}">
              <view class="field-item">
                <view class="field-title">教师喜播 UID</view>
                <input
                  class="field-input"
                  placeholder="请输入教师 UID"
                  value="{{bindUid}}"
                  bindinput="onBindUidInput"
                  focus="{{roleModalStep === 'teacher'}}"
                />
              </view>

              <view class="field-item" style="margin-top: 20rpx;">
                <view class="field-title">激活码 / 授权码</view>
                <input
                  class="field-input mono"
                  placeholder="请输入 8 位激活码，如 AB12CD34"
                  value="{{bindCode}}"
                  bindinput="onBindCodeInput"
                />
                <view class="field-tip">教师需凭管理员发放的 8 位授权激活码进行身份验证。</view>
              </view>
            </block>
          </view>

          <view class="modal-btns" style="margin-top: 32rpx;">
            <view class="modal-btn" catchtap="onCloseRoleModal">取消</view>
            <view class="modal-btn primary {{canSubmitBind ? '' : 'disabled'}}" catchtap="onSubmitRoleBind">
              {{bindSubmitting ? '核验中…' : '确认绑定'}}
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- 弹窗 2：个人信息编辑弹窗（已绑定状态下点击头像或设置入口唤出） -->
    <view class="modal-mask" wx:if="{{profileModalVisible}}" catchtap="closeProfileModal">
      <view class="modal profile-edit-modal" catchtap="noop">
        <view class="modal-header">
          <view class="modal-title">个人信息编辑</view>
          <view class="modal-close" catchtap="closeProfileModal">✕</view>
        </view>
        <view class="modal-desc">修改您的头像、姓名与班级信息</view>

        <!-- 修改头像区域 -->
        <view class="avatar-edit-box" catchtap="onChooseAvatar">
          <view class="avatar-preview-wrap">
            <image class="avatar-preview-img" src="{{editProfile.avatarUrl || userAvatar || '/avatar.png'}}" mode="aspectFill"></image>
            <view class="avatar-camera-badge">📷</view>
          </view>
          <view class="avatar-edit-tip">点击更换头像 (相册/拍照)</view>
        </view>

        <!-- 表单输入区域 -->
        <view class="role-form">
          <view class="field-item">
            <view class="field-title">学员 / 用户姓名</view>
            <input
              class="field-input"
              placeholder="请输入您的姓名或昵称"
              value="{{editProfile.name}}"
              bindinput="onEditNameInput"
              maxlength="20"
            />
          </view>

          <view class="field-item" style="margin-top: 18rpx;">
            <view class="field-title">班级信息</view>
            <input
              class="field-input"
              placeholder="如：2026春季一班"
              value="{{editProfile.className}}"
              bindinput="onEditClassInput"
              maxlength="30"
            />
          </view>

          <view class="field-item" style="margin-top: 18rpx;">
            <view class="field-title">年龄</view>
            <input
              class="field-input"
              type="number"
              placeholder="请输入年龄"
              value="{{editProfile.age}}"
              bindinput="onEditAgeInput"
              maxlength="3"
            />
          </view>
        </view>

        <!-- 重新绑定/切换身份入口 -->
        <view class="rebind-link-row">
          <text class="rebind-link" catchtap="onRebindFromProfileModal">重新绑定 / 切换身份 ›</text>
        </view>

        <view class="modal-btns" style="margin-top: 28rpx;">
          <view class="modal-btn" catchtap="closeProfileModal">取消</view>
          <view class="modal-btn primary {{profileSubmitting ? 'disabled' : ''}}" catchtap="onSubmitProfileEdit">
            {{profileSubmitting ? '保存中…' : '保存修改'}}
          </view>
        </view>
      </view>
    </view>

    <!-- 管理员验证弹窗（PRD 五.1：密码掩码输入，口令提交云函数比对） -->
    <view class="modal-mask" wx:if="{{adminModal}}" catchtap="onAdminCancel">
      <view class="modal" catchtap="noop">
        <view class="modal-title">管理员验证</view>
        <input
          class="input"
          password
          placeholder="请输入管理口令"
          value="{{adminPin}}"
          bindinput="onAdminPinInput"
          confirm-type="done"
          bindconfirm="onAdminConfirm"
        />
        <view class="modal-btns">
          <view class="modal-btn" bindtap="onAdminCancel">取消</view>
          <view class="modal-btn primary" bindtap="onAdminConfirm">确定</view>
        </view>
      </view>
    </view>
  </block>
</view>
