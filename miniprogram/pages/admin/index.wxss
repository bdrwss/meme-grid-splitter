/* 顶部 Tab */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #64748b;
  border-radius: 14rpx;
}

.tab.on {
  background: #2563eb;
  color: #fff;
  font-weight: 600;
}

.center {
  text-align: center;
  padding: 20rpx 0 8rpx;
}

.field-label {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 12rpx;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 220rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.row-btns {
  display: flex;
  gap: 20rpx;
}

.half {
  flex: 1;
}

.gen-count {
  width: 160rpx;
  flex-shrink: 0;
  text-align: center;
}

/* 筛选行 */
.filters {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.f-batch {
  width: 200rpx;
  flex-shrink: 0;
  padding: 14rpx 16rpx;
}

.f-uid {
  flex: 1;
  padding: 14rpx 16rpx;
}

.f-status {
  width: 200rpx;
  flex-shrink: 0;
}

.f-status.wide {
  width: 100%;
}

.picker-val {
  padding: 14rpx 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #475569;
}

/* 列表条目（授权码 / 教师 / 学员共用） */
.code-item,
.t-item,
.stu {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.code-item:last-child,
.t-item:last-child,
.stu:last-child {
  border-bottom: none;
}

.code-main {
  flex: 1;
  min-width: 0;
}

.code-val,
.stu-uid {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
  word-break: break-all;
}

.mono {
  font-family: Menlo, Consolas, monospace;
  letter-spacing: 1rpx;
}

.tag {
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  background: #f1f5f9;
  color: #64748b;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.tag.s1 {
  background: rgba(74, 222, 128, 0.14);
  color: #16a34a;
}

.tag.s2 {
  background: rgba(220, 38, 38, 0.1);
  color: #dc2626;
}

.op {
  font-size: 22rpx;
  color: #2563eb;
  padding: 8rpx 14rpx;
  border: 1rpx solid #bfdbfe;
  border-radius: 10rpx;
  white-space: nowrap;
}

.op.danger {
  color: #dc2626;
  border-color: #fecaca;
}

/* 操作按钮组：窄屏下换行排布 */
.ops-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
  width: 100%;
}
