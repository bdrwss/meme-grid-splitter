page {
  background: #f8fafc;
  font-size: 28rpx;
  color: #0f172a;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.btn-primary {
  background: #2563eb;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-primary.disabled {
  background: #cbd5e1;
  color: #64748b;
}

.btn-ghost {
  border: 1rpx solid #cbd5e1;
  color: #475569;
  border-radius: 16rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
  text-align: center;
  background: #fff;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.input {
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.muted {
  color: #64748b;
  font-size: 24rpx;
}
